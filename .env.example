# Copy this file to .env and fill in real values for your environment.
# Never commit .env - it's in .gitignore.

# --- App ---
PORT=8080
NODE_ENV=development

# Public hostname (no scheme) Twilio can reach - use ngrok in local dev,
# e.g. abcd1234.ngrok.io. Used to build the wss:// media stream URL and to
# validate webhook signatures.
PUBLIC_HOST=localhost:8080

# Simulation mode: run the entire platform with mock providers (no
# credentials, no external calls). Great for local development and demos.
SIMULATION=true

# Directory containing per-tenant JSON config files (FileTenantConfigProvider).
TENANT_CONFIG_DIR=./packages/config/tenants

# --- Observability ---
# OpenTelemetry Collector OTLP/HTTP endpoint (see infra/observability/docker-compose.yml).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info

# --- Data layer ---
# PERSISTENCE=memory (default) needs nothing; PERSISTENCE=postgres requires
# DATABASE_URL (and ideally REDIS_URL for durable session state).
PERSISTENCE=memory
DATABASE_URL=postgres://voice_agent:voice_agent@localhost:5432/voice_agent
REDIS_URL=redis://localhost:6379

# --- Telephony: Twilio ---
# AUTH_TOKEN enables webhook signature validation; SID+TOKEN together enable
# REST call control (clean hangup + transfer-to-human).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- LLM: OpenAI ---
OPENAI_API_KEY=

# --- LLM: Groq (free tier, OpenAI-compatible) ---
# Free key from https://console.groq.com. Powers tenants with "llm":"groq".
# The Groq adapter reuses the OpenAI-wire adapter pointed at GROQ_BASE_URL.
GROQ_API_KEY=
# Optional override; defaults to https://api.groq.com/openai
GROQ_BASE_URL=

# --- TTS: ElevenLabs ---
ELEVENLABS_API_KEY=

# --- STT + TTS: Deepgram ---
# One free-credit key ($200) covers BOTH streaming STT (nova) and streaming
# TTS (Aura). Tenants select TTS with "tts":"deepgram".
DEEPGRAM_API_KEY=

# --- Booking: Cal.com ---
CALCOM_API_KEY=
